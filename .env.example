# Postgres / Supabase database connection (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# First owner account created by the seeder
ADMIN_EMAIL=owner@laughingbuddha.com.bd
ADMIN_PASSWORD=buddha123

# Owner alerts for new reservations & orders (all optional)
# RESEND_API_KEY=re_xxx
# RESEND_FROM=Laughing Buddha <bookings@laughingbuddha.com.bd>
# OWNER_EMAIL=owner@laughingbuddha.com.bd
# TELEGRAM_BOT_TOKEN=123456:abcdef
# TELEGRAM_CHAT_ID=987654321
# OWNER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxx

# Only needed if you move the data layer to the Supabase JS client
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
